{
  "manifest_version": 3,
  "name": "QR THAT!",
  "version": "0.0.1",
  "description": "Turn Firefox pages and links into QR codes for quick transfer to another device.",
  "permissions": ["activeTab", "menus", "storage"],
  "host_permissions": [
    "https://rules1.clearurls.xyz/*",
    "https://rules2.clearurls.xyz/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "qr-that@picklerick2005.github.io",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "action": {
    "default_popup": "popup/popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Alt+Q"
      },
      "description": "Open QR THAT!"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  }
}
