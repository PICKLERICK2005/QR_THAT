{
  "manifest_version": 3,
  "name": "QR THAT!",
  "version": "1.0.0",
  "description": "Turn Firefox pages, links, and images into QR codes with optional local URL sanitization.",
  "permissions": ["activeTab", "menus", "storage", "alarms"],
  "icons": {
    "16": "icons/Logo/qr-that-16.png",
    "32": "icons/Logo/qr-that-32.png",
    "48": "icons/Logo/qr-that-48.png",
    "96": "icons/Logo/qr-that-96.png",
    "128": "icons/Logo/qr-that-128.png",
    "256": "icons/Logo/qr-that-256.png"
  },
  "host_permissions": [
    "https://rules1.clearurls.xyz/*",
    "https://rules2.clearurls.xyz/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "qr-that@picklerick2005.github.io",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/Logo/qr-that-16.png",
      "32": "icons/Logo/qr-that-32.png",
      "48": "icons/Logo/qr-that-48.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Period"
      },
      "description": "Open QR THAT!"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  }
}
